% draw the plot of charging times for trucks

% value(squeeze(sum(P,2)))

ACT = value(P(:,:));

POWS = sum(ACT',2)

sz = size(ACT');



tdep = value(tda);
tarr = value(taa);

TB = T;
T = 1:sz(2);


%%
tptMat = zeros(sz);
for k = K
    for l = 1:maxL


        tspan = ceil(tdep(k,l)):floor(tarr(k,l)); % this is transportaiton

        if tspan>0

        spanload = ceil(tdep(k,l)):(ceil(tdep(k,l)+ttl(k,l)));
        spanuload = ceil(tdep(k,l)):(ceil(tdep(k,l)+ttu(k,l)));

        tptMat(k,tspan) = 1; % code tpt
        tptMat(k,spanload) = 2; % code load
        tptMat(k,spanuload) = 3; % code load
        else
            continue
        end

    end
end
%%
toPlot = ACT' + tptMat;
P_MAX = max(max(toPlot));
%%
% Assuming toPlot, T, K, and P_MAX are defined
figure;
hold on;

% Define colors for each activity
colors = [0 0 1; 0 1 0; 1*0.8 0 0; 0 1 1]*0.8; % Blue for Transport, Green for Charging, Red for Loading, Cyan for Unloading


% Concatenate
for k = K
    
    for t = T
        % Convert datetime to numeric
        numericTime = datenum(TIMES(t));
        activity = toPlot(k, t);
        
        % Determine color based on activity
        if activity > 4 % Charging
            intensity = activity / P_MAX;
            color = colors(2,:); % Vary green intensity based on charging power
        elseif activity == 1 % Transport
            color = colors(1, :);
        elseif activity == 2 % Loading
            color = colors(3, :);
        elseif activity == 3 % Unloading
            color = colors(3, :)*0.8;
        else
            if or(hour(TIMES(t))>22 , hour(TIMES(t))<7)
            color = [0.7 0.7 0.7];
            else
            color = [0.9 0.9 0.9];
            end
        end


        
        % Plot a rectangle for the activity
        % Use in rectangle function
rectangle('Position', [numericTime, k-1, 1, 1], 'FaceColor', color, 'EdgeColor', color);


    end
end

for t = T
    numericTime = datenum(TIMES(t));
    priceColor = [0.9 0.9 0.9] * (1 - PRICES(t) / max(PRICES)); % Scale color based on price
    rectangle('Position', [numericTime, max(K), 1, 0.4], 'FaceColor', priceColor, 'EdgeColor', priceColor);
end

% Set up the plot
xlim([datenum(TIMES(T(1))) datenum(TIMES(T(end)))] );
ylim([0 max(K)+1]);
xlabel('Time');
ylabel('Vehicle');
title('Vehicle Activities Over Time');
set(gca, 'YDir', 'reverse'); % Reverse Y-axis so vehicle 1 is at the bottom
datetick('x','DD HH:MM'); % Format x-axis ticks as time

% Create dummy plot objects for the legend
hTransport = plot(nan, nan, 's', 'MarkerFaceColor', colors(1, :), 'MarkerEdgeColor', colors(1, :));
hCharging = plot(nan, nan, 's', 'MarkerFaceColor', colors(2, :), 'MarkerEdgeColor', colors(2, :));
hLoading = plot(nan, nan, 's', 'MarkerFaceColor', colors(3, :), 'MarkerEdgeColor', colors(3, :));
hUnloading = plot(nan, nan, 's', 'MarkerFaceColor', colors(3, :)*0.8, 'MarkerEdgeColor', colors(3, :)*0.8);
hPrices = plot(nan, nan, 's', 'MarkerFaceColor', [0.9 0.9 0.9], 'MarkerEdgeColor', [0.9 0.9 0.9]);
hNight = plot(nan, nan, 's', 'MarkerFaceColor', [0.7 0.7 0.7], 'MarkerEdgeColor',  [0.7 0.7 0.7]);

% Add legend
legend([hTransport, hCharging, hLoading, hUnloading,hPrices,hNight], {'Transport', 'Charging', 'Loading', 'Unloading','Prices','23:00-06:00'}, 'Location', 'best');
set(gcf, 'Color', 'w');

% legend({'Transport', 'Charging', 'Loading', 'Unloading'});
hold off;

