% Trucks
%%by distance

for d = 4
figure;

K_sub = K(1:5);
pt = tiledlayout(length(K_sub),1);
for k = K_sub
 
    x = [0;cumsum(Dis{d,k})];
    x = [x(1:length(x)-1);x;x(end)];

    e = [Itin_out{d,k}.soc_i;...
         Itin_out{d,k}.soc_i + Itin_out{d,k}.e_charged;...
         Itin_out{d,k}.soc_j(end) ;...
         StartingBattery*B(k) - sum(vertcat(Itin_out{:,k}).cons) + sum(value(e_charge(k,:)))...%Itin_out{d,k}.soc_j(end) + sum(value(e_charge(k,lmax(k)+1:maxL+1)))...
         ]; % additional final charge
    
    text_pf = string([Itin_out{d,k}.origin;Itin_out{d,k}.origin(1)]);
    
    p = [x,e] ;
    
    % You can sort individually for time, we only cared for the battery
    % levels to be consistent with the time of occurence
    p = sortrows(p);

    % Plot next series:
    nexttile
    
    plot(p(:,1),p(:,2));
    
    len = length(L{d,k});
    
    % tex = sprintf('Truck ID # %d with %d stops battery capacity %d kWh',...
    %     k,len,batt_cap(k));
     tex = sprintf('Truck ID # %d with %d stops battery capacity %d kWh',...
       k,len,value(B(k)));
    title(tex);

    hold on
    
    scatter(p(:,1),p(:,2),...
            'MarkerEdgeColor',[0 .5 .5],...
            'MarkerFaceColor',[0 .7 .7],...
            'LineWidth',1.5)
        
    hold on
    
    text([0;cumsum(Dis{d,k})],...
         repmat(batt_cap(k),length(Dis{d,k})+1,1)*0.9,...
         text_pf)           
    tex = sprintf('Truck energy profiles by km for day %d',...
         d);

end

    hold off
    title(pt,tex)
    xlabel(pt, 'Cumulative Distance [km]')
    ylabel(pt, 'SOC [kWh]')
end




%% Trucks

% Put together the schedules

tim_arr = cell(length(D),length(K),1);
tim_dep = tim_arr;
soc_arr = tim_arr;
soc_dep = tim_arr;

data_plot = cell(length(D),length(K),2);

for d = D
for k = K
    for l = L{d,k}'

        if l == 1
    tim_dep{d,k}(1,1) = time_ear{d,k}(1);
    tim_arr{d,k}(1,1) = time_ear{d,k}(1) + hours(Dis{d,k}(l)/data_vehs.av_speed(k) + ch_sol_t{d,k}(l));

        else
    tim_dep{d,k}(l,1) = tim_arr{d,k}(l-1) + minutes(5)*abs(Itin{d,k}.payload_origin(l) -  Itin{d,k}.payload_destination(l)) ; % TODO LOADING UNLOADING TIME
    tim_arr{d,k}(l,1) = tim_dep{d,k}(l) + hours(Dis{d,k}(l)/data_vehs.av_speed(k) + ch_sol_t{d,k}(l));
       
        end

    soc_dep{d,k}(l,1) = ei_sol_m(d,l,k) + ch_sol{d,k}(l);
    soc_arr{d,k}(l,1) = ej_sol_m(d,l,k);

        % Vectors for plotting the profile in realtime
    data_plot{d,k,1} = [data_plot{d,k,1};tim_dep{d,k}(l);tim_arr{d,k}(l)];
    data_plot{d,k,2} = [data_plot{d,k,2};soc_dep{d,k}(l);soc_arr{d,k}(l)];

    end
end
end







for d = D
for k = K
    for l = L{d,k}'

        sol_trucks{d,k}.time_dep = tim_dep{d,k};
        sol_trucks{d,k}.time_arr = tim_arr{d,k};
        
    end
end
end


%% 

for d = D(1:2)
    figure;
pt = tiledlayout(length(K(5:8)),1);
for k = K(5:8)

    nexttile
    
    plot(data_plot{d,k,1},data_plot{d,k,2});
    ylim([0 315])
    yticks([0 100 200 315])
    
    len = length(L{d,k});
    tex = sprintf('Truck ID # %d with %d stops battery capacity %d kWh',...
        k,len,batt_cap(k));
    title(tex);

    hold on
    scatter(data_plot{d,k,1},data_plot{d,k,2},...
            'MarkerEdgeColor',[0 .5 .5],...
            'MarkerFaceColor',[0 .7 .7],...
            'LineWidth',1.5)
        
    hold on
    
%     text([ts;sol_trucks{d,k}.Hour_sim],...
%          repmat(batt_cap(k),length(Dis{d,k})+1,1)*0.9,...
%          text_pf)

    %xtickformat("HH:mm:ss")

    tex = sprintf('Truck energy profiles by time for day %d',...
        d);

end

    hold off
    title(pt,tex)
    xlabel(pt, 'time [hr]')
    ylabel(pt, 'SOC [kWh]')
end

